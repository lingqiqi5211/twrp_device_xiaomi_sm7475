<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
      Builds bootable/recovery from the marble source branch instead of the
      upstream branch plus a patch series, and restores one project that the
      TWRP minimal manifest strips.

      Copy this file into .repo/local_manifests/ and then sync
      bootable/recovery. See the README for the exact commands.

      The branch tracks TWRP-Test/android_bootable_recovery twrp-16.0 and
      carries the marble recovery changes as ordinary commits.
  -->
  <remote name="marble" fetch="https://github.com/lingqiqi5211" />

  <remove-project name="android_bootable_recovery" />

  <project path="bootable/recovery" name="android_bootable_recovery"
           remote="marble" revision="marble-twrp16" />

  <!--
      TWRP's remove-minimal.xml drops this project, but crash_dump links
      libnative_bridge_guest_state_accessor from it. Without it
      ALLOW_MISSING_DEPENDENCIES stubs the module out and crash_dump silently
      produces nothing for the ramdisk.
  -->
  <project path="frameworks/libs/native_bridge_support"
           name="platform/frameworks/libs/native_bridge_support" groups="pdk" />
</manifest>
