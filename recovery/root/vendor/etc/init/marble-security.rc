# Legacy HIDL services remain necessary for Android 15 userdata. Wait for both
# the QSEE listeners and hwservicemanager so the services can register once
# instead of entering an early-boot crash loop.
on property:hwservicemanager.ready=true && property:vendor.sys.listeners.registered=true
    start gatekeeper-1-0
    start vendor.keymaster-4-1

service vendor.qseecomd /system/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

service vendor.keymaster-4-1 /system/bin/android.hardware.keymaster@4.1-service-qti
    class early_hal
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0
