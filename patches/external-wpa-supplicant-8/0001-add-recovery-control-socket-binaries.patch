+// Socket-only recovery binaries. Recovery controls these directly and does
+// not expose either the platform AIDL or the legacy supplicant HIDL service.
+cc_binary {
+    name: "marble_recovery_wpa_cli",
+    srcs: [
+        "wpa_cli.c",
+        "src/common/cli.c",
+        "src/common/wpa_ctrl.c",
+        "src/utils/common.c",
+        "src/utils/edit.c",
+        "src/utils/eloop.c",
+        "src/utils/os_unix.c",
+        "src/utils/wpa_debug.c",
+    ],
+    shared_libs: [
+        "libcutils",
+        "liblog",
+    ],
+    defaults: [
+        "wpa_supplicant_no_aidl_cflags_default",
+        "wpa_supplicant_includes_default",
+    ],
+    cflags: [
+        "-UCONFIG_CTRL_IFACE_CLIENT_DIR",
+        "-UCONFIG_WPA_CLI_HISTORY_DIR",
+        "-DCONFIG_CTRL_IFACE_CLIENT_DIR=\"/tmp/recovery/sockets\"",
+        "-DCONFIG_WPA_CLI_HISTORY_DIR=\"/tmp/recovery\"",
+    ],
+}
+
+cc_binary {
+    name: "marble_recovery_wpa_supplicant",
+    shared_libs: [
+        "libc",
+        "libcrypto",
+        "libcutils",
+        "libkeystore-engine-wifi-hidl",
+        "liblog",
+        "libnl",
+        "libssl",
+    ],
+    defaults: [
+        "wpa_supplicant_srcs_default",
+        "wpa_supplicant_no_aidl_cflags_default",
+        "wpa_supplicant_includes_default",
+    ],
+    cflags: [
+        "-UCONFIG_CTRL_IFACE_CLIENT_DIR",
+        "-UCONFIG_CTRL_IFACE_DIR",
+        "-DCONFIG_CTRL_IFACE_CLIENT_DIR=\"/tmp/recovery/sockets\"",
+        "-DCONFIG_CTRL_IFACE_DIR=\"/tmp/recovery/sockets\"",
+    ],
+}
+
 soong_config_module_type {
